FROM python:3.12-slim

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_ROOT_USER_ACTION=ignore \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /workspace

# The project exposes no installable packages. Installing this metadata-only
# copy creates a reusable dependency layer; source changes are bind-mounted at
# runtime and therefore do not invalidate the image.
COPY pyproject.toml README.md ./
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install ".[test]" "ruff>=0.9"

CMD ["sh", "scripts/check.sh"]
